# Puerto del servidor backend
PORT=3001

# Ruta de la base de datos SQLite (relativa a backend/)
DB_PATH=./database.sqlite

# Secreto para firmar JWT (CÁMBIALO en producción)
JWT_SECRET=rapidito_secret_key_2026

# Expiración del token
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS y Socket.IO, separados por coma.
# Vacío = refleja el origen de la petición (solo desarrollo).
CORS_ORIGINS=

# Geocoding (desarrollo: Nominatim público de OpenStreetMap)
GEOCODING_PROVIDER=osm
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=RutaRides/0.1 (soporte@rutarides.local)
GEOCODING_COUNTRY_CODES=ve
GEOCODING_TIMEOUT_MS=8000

# Routing (desarrollo: OSRM público)
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=
ROUTING_TIMEOUT_MS=8000

# Búsqueda de lugares acotada a Quíbor (viewbox: left,top,right,bottom)
GEOCODING_VIEWBOX=-69.68,9.98,-69.56,9.88
GEOCODING_BOUNDED=true

# Tasa Bs/USD (0 en TASA_CAMBIO_BS = consultar fuente oficial)
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
EXCHANGE_RATE_TIMEOUT_MS=8000
